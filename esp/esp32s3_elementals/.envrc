# Set up ESP32 environment
fish -c esp_env 2>/dev/null || true
export CC=xtensa-esp32s3-elf-gcc
export LIBCLANG_PATH="/home/i/.rustup/toolchains/esp/xtensa-esp32-elf-clang/esp-20.1.1_20250829/esp-clang/lib"
export PATH="/home/i/.rustup/toolchains/esp/xtensa-esp-elf/esp-15.2.0_20250920/xtensa-esp-elf/bin:$PATH"
